# ─────────────────────────────────────────────────────────────
# UDAAN Society — Environment Variables
# Copy this file to .env and fill in real values for production
# ─────────────────────────────────────────────────────────────

# Django Secret Key (generate a new one for production)
SECRET_KEY=your-secret-key-here

# Debug Mode (set to False in production)
DEBUG=True

# Allowed Hosts (comma-separated for production, e.g. udaansociety.org,www.udaansociety.org)
ALLOWED_HOSTS=127.0.0.1,localhost

# ── Email (SMTP) ─────────────────────────────────────────────
# Leave EMAIL_HOST_PASSWORD empty to use console backend (dev mode)
# Set it to enable real email delivery via SMTP

EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=mail@udaansociety.org
EMAIL_HOST_PASSWORD=

# ── Gmail App Password Setup (if using Gmail) ────────────────
# 1. Enable 2-Factor Authentication on your Google account
# 2. Go to: Google Account → Security → App Passwords
# 3. Generate an App Password for "Mail" → "Windows Computer"
# 4. Paste the 16-character password as EMAIL_HOST_PASSWORD above
# Note: Never use your regular Gmail password here

# ── Database (SQLite default, PostgreSQL for production) ─────
# DATABASE_URL=postgres://user:password@host:5432/dbname
